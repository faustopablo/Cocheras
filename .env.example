# Copiar como .env.local y completar con los valores del proyecto de Supabase.

# Panel del proyecto Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Service role key: SOLO se usa en el servidor (Server Actions), nunca se expone
# al cliente. Necesaria para el alta manual de usuarios (/admin/usuarios) vía
# la Admin API de Supabase Auth.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
